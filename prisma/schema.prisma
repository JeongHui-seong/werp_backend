// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output = "../src/generated"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id  String  @id @default(uuid()) @db.Uuid
  email String  @unique
  name  String
  phone String  @unique
  status  String
  hireDate DateTime @default(now()) @map("hire_date")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  deptId Int @map("dept_id")
  roleId Int @map("role_id")

  department  Department  @relation(fields: [deptId], references: [id])
  role  Role  @relation(fields: [roleId], references: [id])
  
  attendances Attendance[]
  LeaveRequest LeaveRequest[]
  approvedLeaves LeaveRequest[] @relation("ApprovedLeaves")
}

model Department {
  id  Int @id @default(autoincrement())
  name  String

  users User[]
}

model Role {
  id  Int @id @default(autoincrement())
  name  String

  users User[]
}

model Attendance {
  id  Int @id @default(autoincrement())
  userId String @db.Uuid @map("user_id")
  date DateTime @db.Date
  clockin DateTime?
  clockout DateTime?
  worktime Int?
  leaveDateId Int? @map("leave_date_id")
  note String? @db.Text

  user User @relation(fields: [userId], references: [id])
  leave_date LeaveDate? @relation(fields: [leaveDateId], references: [id])

  @@index([userId])
  @@index([date])
}

model LeaveRequest {
  id            Int      @id @default(autoincrement())
  userId       String   @db.Uuid @map("user_id")
  approverId   String?  @db.Uuid @map("approver_id")
  leaveTypeId Int @map("leave_type_id")

  startDate    DateTime @db.Date @map("start_date")
  endDate      DateTime @db.Date @map("end_date")

  status        String   @db.VarChar(20)
  reason        String?  @db.VarChar(255)

  createdAt    DateTime @default(now()) @db.Date @map("created_at")
  approvedAt   DateTime? @db.Date @map("approved_at")
  rejectionReason String? @db.VarChar(255) @map("rejection_reason")

  dates         LeaveDate[]

  user          User     @relation(fields: [userId], references: [id])
  approver      User?    @relation("ApprovedLeaves", fields: [approverId], references: [id])
  leave_type    LeaveType @relation(fields: [leaveTypeId], references: [id])
}

model LeaveDate {
  id              Int      @id @default(autoincrement())
  leaveRequestId Int @map("leave_request_id")
  leaveDate      DateTime @db.Date @map("leave_date")

  leave_request   LeaveRequest @relation(fields: [leaveRequestId], references: [id])

  @@unique([leaveRequestId, leaveDate])

  attendances Attendance[]
}


model LeaveType {
  id  Int @id @default(autoincrement())
  type String @db.VarChar(20) @unique
  days Decimal @db.Decimal(3, 2)

  LeaveRequest LeaveRequest[]
}

model LeavePolicy {
  id Int @id @default(autoincrement())
  year Int @unique
  days Int
}